# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the template so others know which vars are needed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# logs
*.log
logs/

# caches
.eslintcache
.cache/
.turbo/

# temp / scratch / backups (local-only helpers)
*.bak
*.tmp
_*.mjs
shoot.mjs
/.figma-ref/
/shots/
/screenshots/

# local secrets / certs
*.key
