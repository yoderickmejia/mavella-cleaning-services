# ------------------------------------------------------------------
# Mavella Cleaning Services — environment variables
# Copy this file to .env and fill in real values before launch.
# ------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG, JSON-LD).
# Baked into the client bundle at BUILD time, so it must also be passed to the
# image build as --build-arg NEXT_PUBLIC_SITE_URL=... (the CI workflow does this).
NEXT_PUBLIC_SITE_URL=https://mavellacleaning.com

# --- Public business contact details (PLACEHOLDERS — replace these) ---
# Shown in the header, footer, contact page and structured data.
NEXT_PUBLIC_PHONE="(555) 014-2080"
NEXT_PUBLIC_PHONE_HREF="+15550142080"
NEXT_PUBLIC_EMAIL="info@mavellacleaning.com"
# WhatsApp number in international format, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP="15550142080"

# --- Email delivery for the quote/contact/newsletter forms (Google Workspace SMTP) ---
# If SMTP_USER/SMTP_PASS are empty, forms run in "log mode": submissions are
# validated and logged server-side and treated as success (no email sent).
# The Workspace mailbox that sends the mail:
SMTP_USER=info@mavellacleaning.com
# A Google "App Password" (16 chars) for that mailbox — NOT the login password.
# Create at: Google Account → Security → 2-Step Verification → App passwords.
SMTP_PASS=
# Optional: defaults to smtp.gmail.com / 465 (SSL). Use 587 for STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Display sender (defaults to SMTP_USER). Must be that Workspace address/alias.
EMAIL_FROM="Mavella Website <info@mavellacleaning.com>"
# Inbox that receives quote & contact leads.
EMAIL_TO=info@mavellacleaning.com

# --- Production image (used by docker-compose.prod.yml) ---
# Replace OWNER with your GitHub username/org (lowercase).
WEB_IMAGE=ghcr.io/OWNER/mavella-web:latest
